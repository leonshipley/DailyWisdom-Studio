# TAB 4: 3-MIN FLOW AI STORY MAKER — ZERO AUTO-RUN UNTIL BUTTON CLICKED
# ==============================================================================
with tab_story:
    st.markdown("### \U0001f3ac 3-Minute AI Story Movie Engine (Gemini Omni 1.2 Flash \u2022 Nano Banana 2.1 \u2022 Google Flow Studio)")

    if "fse_live_logs" not in st.session_state:
        st.session_state["fse_live_logs"] = ["[Studio Idle] Nothing is running. Click Button 1 below when you want to analyze a story."]

    st_left, st_right = st.columns([1.25, 1.0], gap="large")

    with st_left:
        with st.container(border=True):
            st.markdown("#### \U0001f9e0 Step 1: Select Models & Generate 12-Scene Storyboard (~3 Mins)")
            sc_c1, sc_c2 = st.columns(2)
            with sc_c1:
                st_ar = st.selectbox("\U0001f4d0 Movie Aspect Ratio:", ["16:9 Horizontal (1920x1080)", "9:16 Vertical Short Movie (1080x1920)"], index=0, key="st_ar_sel")
                st_img_engine = st.selectbox(
                    "\U0001f5bc\ufe0f Image Generation Model:",
                    [
                        "Auto (Google Image API \u2794 Flux HD 2K Super-Sharp)",
                        "Google Image API (gemini-2.0-flash-preview-image-generation)",
                        "Flux Pro HD + 2K Lanczos Super-Sharp Only"
                    ],
                    key="st_img_eng_sel"
                )
            with sc_c2:
                st_num_sc = st.slider("\U0001f39e\ufe0f Number of Scenes (12 x 15s = 3 Mins):", min_value=6, max_value=15, value=12, key="st_num_sc")
                st_vid_engine = st.selectbox(
                    "\U0001f3a5 Video Generation Mode:",
                    [
                        "Ultra-Sharp 1080p Lanczos Camera Motion (Instant Local Render)",
                        "Gemini Omni 1.2 Flash API (With Automatic Local Motion Fallback)",
                        "Google Flow Web Studio Bridge (flow.google Bulk Import)"
                    ],
                    key="st_vid_eng_sel"
                )

            st_mode = st.radio("Story Source:", ["\U0001f4d6 12 Viral Biblical & Faith Stories", "\u270d\ufe0f Custom 3-Minute Story Idea"], horizontal=True, key="st_src_mode")
            if "12 Viral" in st_mode:
                st_chosen_topic = st.selectbox("Select Story:", fse.PRESET_STORY_TOPICS, key="st_preset_dd")
            else:
                st_chosen_topic = st.text_input("Describe Your Story Idea:", value="A widow praying over her last loaf of bread when a stranger knocks on her door", key="st_cust_topic")

            st.markdown("##### \U0001f4df Live Execution & Error Diagnostic Console")
            log_placeholder = st.empty()

            def _append_log(msg_str: str):
                ts = time.strftime("%H:%M:%S")
                st.session_state["fse_live_logs"].append(f"[{ts}] {msg_str}")
                log_placeholder.code("\n".join(st.session_state["fse_live_logs"][-14:]), language="text")

            log_placeholder.code("\n".join(st.session_state["fse_live_logs"][-14:]), language="text")

            if st.button("\U0001f9e0 1. Analyze Story & Generate 12-Scene Omni / Flow Storyboard", key="st_gen_board_btn", width="stretch"):
                st.session_state["fse_live_logs"] = []
                sb_loader = LiveTaskLoader("Analyzing Story & Locking Character DNA")
                sb_new = fse.analyze_and_create_story_board(st_chosen_topic, aspect_ratio=st_ar, num_scenes=st_num_sc, log_cb=_append_log)
                st.session_state["active_story_board"] = sb_new
                st.session_state["active_story_folder"] = str(fse.get_next_story_folder(sb_new["story_title"]))
                sb_loader.complete("\u2705 12-Scene Storyboard & Character DNA Ready!")

            if "active_story_board" not in st.session_state:
                st.info("\U0001f449 Click **1. Analyze Story & Generate 12-Scene Omni / Flow Storyboard** above to start. Nothing runs until you press the button!")
            else:
                sb = st.session_state["active_story_board"]
                work_dir = Path(st.session_state["active_story_folder"])
                scenes_dir = work_dir / "scenes"
                scenes_dir.mkdir(parents=True, exist_ok=True)

                st.markdown(
                    f'<div class="verse-card">'
                    f'<div class="verse-hdr">\U0001f3ac {sb["story_title"]} ({sb["anchor_verse_ref"]})</div>'
                    f'<div class="verse-body"><b>\U0001f9ec Locked Character DNA (Flow Ingredients):</b> {sb["character_dna"]}</div>'
                    f'</div>',
                    unsafe_allow_html=True
                )

                st.markdown("#### \U0001f3a8 Step 2: Generate Ultra-Sharp Images, Motion Clips, or Bulk-Import from Google Flow")
                act_c1, act_c2, act_c3 = st.columns(3)
                with act_c1:
                    if st.button("\U0001f5bc\ufe0f 2A. Turbo-Generate All 12 Sharp Images", key="st_gen_all_imgs", width="stretch"):
                        st.session_state["fse_live_logs"] = []
                        img_loader = LiveTaskLoader("Parallel 4x HD Scene Image Generator")
                        fse.generate_all_scene_images_parallel(
                            sb, scenes_dir, image_model_pref=st_img_engine,
                            progress_cb=lambda p, m: img_loader.update(p, m),
                            log_cb=_append_log
                        )
                        img_loader.complete("\u2705 All 12 Scene Images Mastered in 1080p HD!")

                with act_c2:
                    if st.button("\U0001f3a5 2B. Generate All 12 Scene Video Clips", key="st_gen_all_omni", width="stretch"):
                        st.session_state["fse_live_logs"] = []
                        omni_loader = LiveTaskLoader("Building 12 Scene Video Clips (1080p)")
                        for idx_s, sc_item in enumerate(sb["scenes"], start=1):
                            pct_v = int((idx_s - 1) / len(sb["scenes"]) * 100)
                            omni_loader.update(pct_v, f"\U0001f3a5 Scene {idx_s}/{len(sb['scenes'])}: Building 1080p Video Clip...")
                            ref_img = scenes_dir / f"scene_{idx_s:02d}.jpg"
                            if not ref_img.exists():
                                _append_log(f"Scene {idx_s:02d}: Generating start image first...")
                                fse.generate_scene_image(sc_item["flow_image_prompt"], ref_img, sb["aspect_ratio"], seed=400 + idx_s, log_cb=_append_log)
                            out_vid = scenes_dir / f"scene_{idx_s:02d}_flow.mp4"
                            if "Camera Motion" in st_vid_engine:
                                ok_om, msg_om = fse.render_local_3d_motion_clip(ref_img, out_vid, duration_sec=10.0, aspect_ratio=sb["aspect_ratio"], scene_num=idx_s)
                            else:
                                ok_om, msg_om = fse.generate_scene_video_omni(
                                    sc_item["flow_video_prompt"], out_vid, ref_image_path=ref_img,
                                    aspect_ratio=sb["aspect_ratio"], scene_num=idx_s,
                                    allow_local_fallback=True, log_cb=_append_log
                                )
                            _append_log(f"Scene {idx_s:02d}: {msg_om}")
                        omni_loader.complete("\u2705 All 12 Scene Video Clips (.mp4) Ready!")

                with act_c3:
                    csv_bytes = fse.build_google_flow_csv_bytes(sb)
                    st.download_button(
                        "\U0001f4e5 2C. Export Google Flow CSV Queue",
                        data=csv_bytes,
                        file_name="google_flow_omni_queue.csv",
                        mime="text/csv",
                        width="stretch"
                    )

                with st.expander("\U0001f4e6 Bulk Drop Zone: Drop Multiple Clips (.mp4) or Images (.png/.jpg) from Google Flow at Once", expanded=False):
                    bulk_files = st.file_uploader("Select Multiple Flow Videos or Images:", type=["mp4", "mov", "webm", "jpg", "jpeg", "png", "webp"], accept_multiple_files=True, key="st_bulk_flow")
                    if bulk_files:
                        is_v_ar = "9:16" in sb["aspect_ratio"]
                        tw, th = (1080, 1920) if is_v_ar else (1920, 1080)
                        for b_idx, bf in enumerate(sorted(bulk_files, key=lambda x: x.name), start=1):
                            if b_idx > len(sb["scenes"]):
                                break
                            ext = Path(bf.name).suffix.lower()
                            if ext in (".mp4", ".mov", ".webm"):
                                target_f = scenes_dir / f"scene_{b_idx:02d}_flow.mp4"
                                target_f.write_bytes(bf.getvalue())
                            else:
                                target_f = scenes_dir / f"scene_{b_idx:02d}.jpg"
                                target_f.write_bytes(bf.getvalue())
                                fse.master_sharp_hd_image(target_f, tw, th)
                        st.success(f"\u2705 Auto-assigned {min(len(bulk_files), len(sb['scenes']))} file(s)!")

                with st.expander("\U0001f39e\ufe0f Inspect / Edit Individual Scenes, Prompts & HD Previews", expanded=False):
                    for s_obj in sb["scenes"]:
                        snum = s_obj["scene_num"]
                        st.markdown(f"**Scene {snum} \u2014 {s_obj.get('act', '')}**")
                        s_obj["narration"] = st.text_area(f"Spoken Narration (Scene {snum}):", value=s_obj["narration"], height=68, key=f"st_narr_{snum}")
                        s_obj["flow_image_prompt"] = st.text_area(f"Nano Banana / Flow Image Prompt (Scene {snum}):", value=s_obj["flow_image_prompt"], height=68, key=f"st_imgp_{snum}")
                        st.code(s_obj["flow_video_prompt"], language="text")

                        sc_img_p = scenes_dir / f"scene_{snum:02d}.jpg"
                        sc_vid_p = scenes_dir / f"scene_{snum:02d}_flow.mp4"
                        u_c1, u_c2 = st.columns(2)
                        with u_c1:
                            if sc_img_p.exists():
                                st.image(str(sc_img_p), caption=f"Scene {snum} HD Image", width="stretch")
                            if st.button(f"\U0001f504 Regenerate Scene {snum} Image", key=f"st_regen_i_{snum}", width="stretch"):
                                fse.generate_scene_image(s_obj["flow_image_prompt"], sc_img_p, sb["aspect_ratio"], seed=500 + snum, image_model_pref=st_img_engine, log_cb=_append_log)
                                st.rerun()
                        with u_c2:
                            if sc_vid_p.exists():
                                st.video(str(sc_vid_p))
                            up_flow_vid = st.file_uploader(f"Drop Flow Video Clip (Scene {snum} .mp4):", type=["mp4", "mov", "webm"], key=f"st_up_v_{snum}")
                            if up_flow_vid is not None:
                                sc_vid_p.write_bytes(up_flow_vid.getvalue())
                                st.success(f"\u2705 Attached to Scene {snum}!")
                        st.divider()

                st.markdown("#### \U0001f39e\ufe0f Step 3: Merge All Scenes into 1080p HD 3-Minute Movie")
                if st.button("\U0001f680 3. MERGE & RENDER COMPLETE 3-MINUTE 1080p HD STORY MOVIE", key="st_render_movie_btn", width="stretch"):
                    st.session_state["fse_live_logs"] = []
                    mv_loader = LiveTaskLoader("Mastering 3-Minute 1080p Story Movie (Lanczos + Unsharp)")
                    ok_m, out_mv, out_th = fse.render_complete_3min_story_movie(
                        sb, work_dir, voice_name=global_v_obj["voice"], voice_rate=global_rate_str,
                        bgm_file=global_bgm_file, bgm_vol=global_bgm_vol, palette_name=global_palette,
                        progress_cb=lambda pct, msg: mv_loader.update(pct, msg),
                        log_cb=_append_log
                    )
                    if ok_m:
                        story_desc = (
                            f"\U0001f3ac {sb['story_title']}\n\n"
                            f"\U0001f4d6 Anchor Scripture: {sb['anchor_verse_ref']}\n"
                            f"\"{sb['anchor_verse_text']}\"\n\n"
                            f"Watch this deeply moving 3-minute faith story until the very end. Type AMEN in the comments! \U0001f64f\n\n"
                            f"#BibleStory #FaithStory #ChristianMotivation #JesusChrist #GodIsGood #DailyWisdom"
                        )
                        story_tags = ["Bible Story", "Christian Short Film", "Faith Story", "Jesus Christ", sb["anchor_verse_ref"], "Inspirational Story"]
                        backend.save_clip_metadata(out_mv, sb["story_title"], story_desc, story_tags, topic=sb["topic"])
                        st.session_state["last_story_movie"] = str(out_mv)
                        mv_loader.complete(f"\U0001f389 3-Minute 1080p HD Movie Rendered: `{out_mv.name}`!")
                        time.sleep(0.5)
                        st.rerun()

    with st_right:
        with st.container(border=True):
            st.markdown("#### \U0001f37f 3-Minute Story Movie Monitor & Publisher")
            existing_movies = sorted(list(fse.STORY_MOVIES_DIR.rglob("ST*.mp4")), key=lambda p: p.parent.name, reverse=True)
            st_preview = st.session_state.get("last_story_movie")
            if not st_preview or not Path(st_preview).exists():
                st_preview = str(existing_movies[0]) if existing_movies else None

            if not st_preview:
                st.info("\U0001f3ac Your rendered 3-Minute Story Movie and 1-Click YouTube Publisher will appear here!")
            else:
                mv_p = Path(st_preview)
                mv_th = mv_p.with_name(f"{mv_p.stem}_thumb.jpg")
                mv_meta = backend.load_clip_metadata(mv_p)
                mv_dur = cached_video_dur(str(mv_p))

                st.markdown(f"**\u23f1\ufe0f Movie Duration:** `{int(mv_dur//60)}m {int(mv_dur%60)}s` ({mv_dur:.1f}s) &nbsp;|&nbsp; \U0001f4c1 `{mv_p.parent.name}`")
                st.video(str(mv_p))
                mv_th = render_custom_thumbnail_manager(mv_p, f"st_{mv_p.parent.name}") or mv_th

                st.markdown(f"**\U0001f3c6 Story Title:** `{mv_meta['title']}`")
                with st.expander("\U0001f4dd View Story Description & Tags"):
                    st.text_area("Description:", value=mv_meta["description"], height=140, key="st_mon_desc")

                if mv_meta.get("youtube_id"):
                    yt_link = "https://www.youtube.com/watch?v=" + str(mv_meta["youtube_id"])
                    st.success(f"\U0001f389 LIVE ON YOUTUBE: {yt_link}")
                else:
                    if st.button(f"\U0001f680 Publish 3-Min Story Movie + Thumbnail to '{global_target_ch}'", key="st_pub_main", width="stretch"):
                        with st.spinner(f"Uploading {mv_p.name} to {global_target_ch}..."):
                            yt_id = backend.upload_video_to_youtube(global_target_ch, mv_p, thumbnail_path=mv_th)
                            if yt_id:
                                st.success(f"\U0001f389 Published! ID: {yt_id}")
                                time.sleep(1.0)
                                st.rerun()

# ==============================================================================
# TAB 5: VIDEO LIBRARY (PAGINATED FOR INSTANT SPEED)
# ==============================================================================
with tab_lib:
    st.markdown("### \U0001f4c2 Sequential Shorts Vault (`001_`, `002_`, `003_...`)")
    if not all_videos:
        st.info("No videos in `clips/` yet. Generate your first Short!")
    else:
        show_all_vids = st.checkbox(f"Show All {len(all_videos)} Videos (Default shows newest 6 for fast UI speed)", value=False, key="lib_show_all")
        display_vids = all_videos if show_all_vids else all_videos[:6]
        for i in range(0, len(display_vids), 3):
            cols = st.columns(3, gap="medium")
            for j in range(3):
                if i + j < len(display_vids):
                    vid = display_vids[i + j]
                    thumb = vid.with_name(f"{vid.stem}_thumb.jpg")
                    meta = backend.load_clip_metadata(vid)
                    with cols[j]:
                        with st.container(border=True):
                            badge = "\U0001f7e2 LIVE" if meta.get("youtube_id") else "\U0001f535 READY"
                            st.markdown(f"**`{vid.parent.name}`** \u2014 `{badge}`")
                            if thumb.exists():
                                st.image(str(thumb), width="stretch")
                            st.caption(f"\U0001f4cc **{meta['title']}**")
                            if meta.get("youtube_id"):
                                st.success(f"https://youtube.com/shorts/{meta['youtube_id']}")
                            else:
                                if st.button(f"\U0001f680 Upload to {global_target_ch}", key=f"grid_up_{vid.parent.name}", width="stretch"):
                                    with st.spinner(f"Publishing to {global_target_ch}..."):
                                        yt_id = backend.upload_video_to_youtube(global_target_ch, vid)
                                        if yt_id:
                                            st.rerun()
                            if st.button(f"\U0001f5d1\ufe0f Delete {vid.parent.name}", key=f"grid_del_{vid.parent.name}", width="stretch"):
                                shutil.rmtree(vid.parent, ignore_errors=True)
                                st.rerun()

# ==============================================================================
# TAB 6: PODCAST CLIPPER & VIRALITY SPY
# ==============================================================================
with tab_pod:
    p_c1, p_c2 = st.columns(2, gap="large")
    with p_c1:
        with st.container(border=True):
            st.markdown("#### \U0001f399\ufe0f Auto-Scout 1M+ View Podcasts & Clip")
            cat_map = {v["name"]: k for k, v in backend.CATEGORIES.items()}
            chosen_cat_name = st.selectbox("Select Niche:", list(cat_map.keys()))
            cat_cfg = backend.CATEGORIES[cat_map[chosen_cat_name]]
            if st.button(f"\u26a1 Auto-Scout & Clip '{chosen_cat_name}'", width="stretch"):
                with st.spinner("Scanning for 1M+ view videos..."):
                    target = backend.find_viral_video(1_000_000, cat_cfg["queries"])
                    if target:
                        tr = backend.get_transcript(target["id"])
                        clips = backend.analyze_transcript(tr, chosen_cat_name) if tr else backend.analyze_audio_fallback(target["url"], chosen_cat_name)
                        for clip in clips:
                            s_sec, e_sec = backend.timestamp_to_seconds(clip.start_time), backend.timestamp_to_seconds(clip.end_time)
                            tmp = backend.BASE_DIR / "temp_slice.mp4"
                            try:
                                backend.download_slice(target["url"], s_sec, e_sec, tmp)
                                seq_name = f"{backend.clean_filename(clip.book_title)}_{backend.clean_filename(clip.title)}"
                                seq_dir = backend.get_next_sequence_folder(seq_name)
                                out_f = seq_dir / f"{seq_name}.mp4"
                                if backend.render_podcast_short(tmp, clip, out_f, cat_cfg["badge_tag"]):
                                    backend.save_clip_metadata(out_f, clip.title, clip.hook_caption, clip.hashtags)
                                    st.success(f"Created `{seq_dir.name}`!")
                            finally:
                                tmp.unlink(missing_ok=True)
    with p_c2:
        with st.container(border=True):
            st.markdown("#### \U0001f525 Competitor Title Velocity & SEO Spy")
            spy_q = st.text_input("Topic to Spy On:", value="Miracle Debt Prayer")
            if st.button("\U0001f525 Audit Competition & Generate Winning Title", width="stretch"):
                with st.spinner("Analyzing top YouTube Shorts velocity..."):
                    comps = backend.scan_competitor_shorts(spy_q)
                    for c in comps[:4]:
                        st.caption(f"\U0001f525 **{c['title'][:48]}** \u2014 `{c.get('views_per_day', 0):,.0f} views/day`")
                    win_t, _, win_tags = backend.optimize_with_virality_engine(spy_q, f"Prayer for {spy_q}", "", ["Shorts"], global_target_ch)
                    st.success(f"\U0001f680 **Winning Title:** `{win_t}`")
                    st.code(", ".join(win_tags), language="text")

# ==============================================================================
# TAB 7: CHANNEL ANALYTICS — ZERO AUTO-RUN UNTIL BUTTON CLICKED
# ==============================================================================
with tab_stats:
    st.markdown("### \U0001f4ca Complete YouTube Channel Intelligence, Subscribers, Geography & Traffic Suite")
    if not channel_names:
        st.warning("No YouTube channels connected yet.")
    else:
        ctl_c1, ctl_c2, ctl_c3, ctl_c4 = st.columns([1.4, 1.1, 1.1, 1.3])
        with ctl_c1:
            stat_ch = st.selectbox("\U0001f4fa Select Channel to Audit:", channel_names, key="stats_ch_sel")
        with ctl_c2:
            period_map = {"Last 28 Days": 28, "Last 90 Days": 90, "Last 365 Days": 365}
            stat_period_lbl = st.selectbox("\U0001f4c5 Analytics Window:", list(period_map.keys()), index=1, key="stats_period_sel")
            stat_days = period_map[stat_period_lbl]
        with ctl_c3:
            st.markdown("<div style='height:26px;'></div>", unsafe_allow_html=True)
            if st.button("\U0001f504 Load / Refresh All Counts", key="refresh_stats_btn", width="stretch"):
                import importlib
                importlib.reload(cae)
                with st.spinner(f"Auditing all videos, subscribers, and geography for '{stat_ch}'..."):
                    st.session_state[f"full_intel_{stat_ch}_{stat_days}"] = cae.fetch_complete_channel_intelligence(stat_ch, days_back=stat_days)
        with ctl_c4:
            st.markdown("<div style='height:26px;'></div>", unsafe_allow_html=True)
            if st.button("\U0001f513 Re-Link Full Analytics Permission", key="reauth_stats_btn", width="stretch"):
                with st.spinner("Opening Google login in browser..."):
                    ok_a, msg_a = cae.reauthorize_channel_full_analytics(stat_ch)
                    if ok_a:
                        st.session_state[f"full_intel_{stat_ch}_{stat_days}"] = cae.fetch_complete_channel_intelligence(stat_ch, days_back=stat_days)
                        st.rerun()

        cache_k = f"full_intel_{stat_ch}_{stat_days}"
        intel = st.session_state.get(cache_k)

        if intel is None:
            st.info(f"\U0001f449 Click **\U0001f504 Load / Refresh All Counts** above to load live Subscribers, Video Audit, and Geography for **{stat_ch}**.")
        elif not intel.get("ok"):
            st.error(f"\u26a0\ufe0f {intel.get('error', 'Could not load channel data.')}")
        else:
            ov = intel["overview"]
            tot = intel["totals"]
            vids = intel["videos"]

            live_views = max(ov["lifetime_views"], sum(v["views"] for v in vids))
            wh_mins = tot["watch_time_minutes_period"] or int(round(sum(v["views"] * max(12, min(v["duration_sec"], 60)) * 0.78 for v in vids) / 60.0))
            wh_hrs = round(wh_mins / 60.0, 1)
            top_vpd = max([round(v["views"] / max(1.0, v["age_days"]), 1) for v in vids], default=0.0)
            top_v_views = max([v["views"] for v in vids], default=0)

            st.caption(
                f"**Channel:** `{ov['title']}` ({ov['handle'] or 'No Handle'}) &nbsp;\u2022&nbsp; "
                f"**ID:** `{ov['channel_id']}` &nbsp;\u2022&nbsp; "
                f"**Created:** `{ov['published_at']}` ({ov['channel_age_days']}d old) &nbsp;\u2022&nbsp; "
                f"**Videos Audited:** `{tot['analyzed_videos']}`"
            )

            def _card(lbl, val, sub, col="#3B82F6"):
                return (
                    f'<div style="background:rgba(9,14,26,0.92);border:1px solid rgba(59,130,246,0.35);border-top:4px solid {col};'
                    f'border-radius:12px;padding:14px 16px;margin-bottom:10px;">'
                    f'<div style="font-size:11.5px;color:#94A3B8;font-weight:700;text-transform:uppercase;">{lbl}</div>'
                    f'<div style="font-size:26px;font-weight:800;color:#FFFFFF;margin:4px 0;">{val}</div>'
                    f'<div style="font-size:12px;color:#34D399;font-weight:600;">{sub}</div></div>'
                )

            r1 = st.columns(4)
            r1[0].markdown(_card("\U0001f465 Total Subscribers", f"{ov['subscribers']:,}", f"Channel Age: {ov['channel_age_days']} days"), unsafe_allow_html=True)
            r1[1].markdown(_card("\U0001f441\ufe0f Total Channel Views", f"{live_views:,}", f"{tot['shorts_views']:,} Shorts \u2022 {tot['longform_views']:,} Long-Form", "#DC2626"), unsafe_allow_html=True)
            r1[2].markdown(_card("\U0001f4f9 Total Public Videos", f"{max(ov['total_videos'], len(vids)):,}", f"{tot['shorts_count']} Shorts \u2022 {tot['longform_count']} Long-Form"), unsafe_allow_html=True)
            r1[3].markdown(_card("\u23f1\ufe0f Est. Watch Time", f"{wh_hrs:,.1f} hrs", f"{wh_mins:,} Watch Minutes", "#DC2626"), unsafe_allow_html=True)

            r2 = st.columns(4)
            r2[0].markdown(_card("\U0001f44d Total Likes", f"{tot['total_likes']:,}", f"Avg {int(tot['total_likes']//max(1,len(vids)))} likes / video"), unsafe_allow_html=True)
            r2[1].markdown(_card("\U0001f4ac Total Comments", f"{tot['total_comments']:,}", f"Avg {round(tot['total_comments']/max(1,len(vids)),1)} comments / video", "#DC2626"), unsafe_allow_html=True)
            r2[2].markdown(_card("\U0001f525 Engagement Rate", f"{tot['engagement_rate_pct']:.2f}%", f"Avg Short: {tot['avg_views_per_short']:,} views"), unsafe_allow_html=True)
            r2[3].markdown(_card("\U0001f680 #1 Video Velocity", f"{top_vpd:,.0f} views/day", f"Top Video: {top_v_views:,} views", "#DC2626"), unsafe_allow_html=True)

            sub_t1, sub_t2, sub_t3, sub_t4, sub_t5 = st.tabs([
                "\U0001f4cb 1. All Videos Master Table",
                "\U0001f4c8 2. Daily Views, Likes & Watch Time",
                "\u23f0 3. Best IST Posting Hours & Formats",
                "\U0001f30d 4. Geography (Country Breakdown)",
                "\U0001f9ed 5. Traffic Sources & Devices"
            ])

            with sub_t1:
                if vids:
                    df_vids = pd.DataFrame([
                        {
                            "Rank": f"#{idx}",
                            "Type": v["type"],
                            "Title": v["title"],
                            "Views": v["views"],
                            "Views/Day": round(v["views"] / max(1.0, v["age_days"]), 1),
                            "Likes": v["likes"],
                            "Comments": v["comments"],
                            "Engagement %": f"{v['engagement_pct']}%",
                            "Duration": v["duration_str"],
                            "Published (IST)": v["published_date"],
                        }
                        for idx, v in enumerate(vids, start=1)
                    ])
                    st.dataframe(df_vids, hide_index=True, width="stretch")
                    c_ch1, c_ch2 = st.columns(2)
                    with c_ch1:
                        st.caption("\U0001f4ca Top Videos by Total Views:")
                        st.bar_chart({v["title"][:28] + "...": v["views"] for v in vids[:12]})
                    with c_ch2:
                        st.caption("\U0001f44d Top Videos by Likes:")
                        st.bar_chart({v["title"][:28] + "...": v["likes"] for v in vids[:12]})

            with sub_t2:
                d_rows = intel.get("daily_rows", [])
                if d_rows:
                    df_day = pd.DataFrame(d_rows).set_index("Date")
                    st.line_chart(df_day[["Views", "Watch Minutes", "Likes"]])
                    st.dataframe(pd.DataFrame(d_rows).sort_values("Date", ascending=False), hide_index=True, width="stretch")

            with sub_t3:
                f_c1, f_c2 = st.columns(2, gap="large")
                with f_c1:
                    st.markdown("##### \U0001f4f1 Shorts vs \U0001f4fa Long-Form Breakdown")
                    df_fmt = pd.DataFrame([
                        {"Format": "Shorts (<=3m)", "Videos": tot["shorts_count"], "Total Views": tot["shorts_views"], "Avg Views": tot["avg_views_per_short"]},
                        {"Format": "Long-Form (>3m)", "Videos": tot["longform_count"], "Total Views": tot["longform_views"], "Avg Views": tot["avg_views_per_longform"]},
                    ])
                    st.dataframe(df_fmt, hide_index=True, width="stretch")
                    st.bar_chart({"Shorts Views": tot["shorts_views"], "Long-Form Views": tot["longform_views"]})
                with f_c2:
                    st.markdown("##### \u23f0 Best Posting Hours on Your Channel (IST)")
                    bh = intel.get("best_hours_ist", [])
                    if bh:
                        st.dataframe(pd.DataFrame(bh), hide_index=True, width="stretch")
                        st.bar_chart({r["hour_ist"]: r["avg_views"] for r in bh[:8]})

            with sub_t4:
                geo_rows = intel.get("geo_rows", [])
                if geo_rows:
                    g1, g2 = st.columns([1.3, 1.0])
                    with g1:
                        st.dataframe(pd.DataFrame(geo_rows), hide_index=True, width="stretch")
                    with g2:
                        st.bar_chart({g["Country"]: g["Views"] for g in geo_rows})
                else:
                    st.info("YouTube's country-level Geography database updates 48-72 hours after a new channel's first views (your channel is 2 days old). Enable YouTube Analytics API in Google Cloud Console if not enabled yet.")

            with sub_t5:
                tr_rows = intel.get("traffic_rows", [])
                dv_rows = intel.get("device_rows", [])
                if tr_rows or dv_rows:
                    tc1, tc2 = st.columns(2)
                    with tc1:
                        if tr_rows:
                            st.dataframe(pd.DataFrame(tr_rows), hide_index=True, width="stretch")
                    with tc2:
                        if dv_rows:
                            st.dataframe(pd.DataFrame(dv_rows), hide_index=True, width="stretch")
                else:
                    st.info("Traffic Source & Device breakdowns populate 48-72 hours after initial views on new channels.")
