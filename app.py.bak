# TAB 3: LONG-FORM PRAYER VIDEOS (5M - 1 HOUR) — ZERO AUTO-RUN
# ==============================================================================
with tab_long:
    st.markdown("### \U0001f54a\ufe0f Long-Form Soul Prayer & Scripture Sanctuary (5 Min \u2022 10 Min \u2022 20 Min \u2022 30 Min \u2022 1 Hour)")
    lf_left, lf_right = st.columns([1.18, 1.0], gap="large")

    with lf_left:
        with st.container(border=True):
            st.markdown("#### \U0001f64f Step 1: Prayer Duration, Topic & Soul Pacing")
            lf_c1, lf_c2 = st.columns(2)
            with lf_c1:
                lf_dur = st.selectbox("\u23f1\ufe0f Select Long-Form Video Length:", list(lpe.DURATION_CONFIGS.keys()), index=1, key="lf_dur_sel")
            with lf_c2:
                lf_nature = st.selectbox("\U0001f327\ufe0f Nature Soaking Layer (Underneath Music):", ["None (Pure Worship Music)", "Gentle Night Rain", "Peaceful Mountain Stream"], index=1, key="lf_nat_sel")

            lf_topic_mode = st.radio("Choose Prayer Topic Source:", ["\U0001f4d6 50 Deep Prayer Topics", "\u270d\ufe0f Custom Soul-Prayer Topic"], horizontal=True, key="lf_topic_mode")
            if "50 Deep" in lf_topic_mode:
                lf_t_labels = [f"{item['id']}. {item['topic']}" for item in TOP_50_PRAYER_TOPICS]
                lf_chosen_lbl = st.selectbox("Select Prayer Topic:", lf_t_labels, key="lf_topic_dd")
                lf_topic = TOP_50_PRAYER_TOPICS[lf_t_labels.index(lf_chosen_lbl)]["topic"]
            else:
                lf_topic = st.text_input("Enter Custom Prayer Topic:", value="Deep Peace, Sleep Protection & Freedom from Anxiety", key="lf_cust_topic")

            if st.button("\U0001f4dc 1. Generate 5-Stage Soul-Prayer Script & Scriptures", key="lf_gen_script_btn", width="stretch"):
                with st.spinner(f"Crafting 5-Stage Soul-Prayer Journey & loading Scriptures for '{lf_topic}' ({lf_dur})..."):
                    st.session_state["lf_active_journey"] = lpe.generate_soul_prayer_journey(lf_topic, lf_dur)

            if "lf_active_journey" not in st.session_state:
                st.info("\U0001f449 Click **1. Generate 5-Stage Soul-Prayer Script & Scriptures** above when you are ready to build a Long-Form Prayer Video.")
                lf_journey = None
            else:
                lf_journey = st.session_state["lf_active_journey"]
                vers_list_str = ", ".join([v["ref"] for v in lf_journey["scriptures"]])
                st.markdown(
                    f'<div class="verse-card">'
                    f'<div class="verse-hdr">\U0001f4d6 {len(lf_journey["scriptures"])} Anchor Scriptures Loaded for {lf_dur}:</div>'
                    f'<div class="verse-body">{vers_list_str}</div>'
                    f'</div>',
                    unsafe_allow_html=True
                )
                with st.expander("\U0001f4dd View / Edit 5-Stage Soul-Prayer Movements Before Rendering"):
                    for stg in lf_journey["stages"]:
                        st.markdown(f"**Stage {stg['stage_num']}: {stg['chapter_title']}**")
                        edited_stg = st.text_area(f"Spoken Prayer (Stage {stg['stage_num']}):", value=stg["full_text"], height=100, key=f"lf_stg_edit_{stg['stage_num']}")
                        stg["full_text"] = edited_stg.strip()
                        stg["paragraphs"] = [p.strip() for p in re.split(r"\n\s*\n", edited_stg) if p.strip()]

                v_col1, v_col2 = st.columns(2)
                intro_vids = get_media_files(backend.INTRO_DIR, (".mp4", ".mov", ".webm", ".mkv"))
                bg_imgs = get_media_files(backend.BG_DIR, (".jpg", ".jpeg", ".png", ".webp"))
                with v_col1:
                    lf_vis_mode = st.selectbox("\U0001f3ac 16:9 Visual Style:", ["Looping Video Background (Fastest)", "Cinematic Ken Burns Wallpaper"], key="lf_vis_mode")
                    lf_pick_vid = st.selectbox("\U0001f3ac Looping Video Source:", ["Auto / Newest"] + [f.name for f in intro_vids], key="lf_vid_dd")
                with v_col2:
                    lf_pick_img = st.selectbox("\U0001f5bc\ufe0f 16:9 Wallpaper / Thumbnail Image:", ["Auto / Newest"] + [f.name for f in bg_imgs], key="lf_img_dd")

                if st.button(f"\U0001f680 2. RENDER {lf_dur.upper()} 16:9 SOUL-PRAYER VIDEO", key="lf_render_btn", width="stretch"):
                    lf_loader = LiveTaskLoader(f"Producing {lf_dur} Soul-Prayer Video")
                    out_folder = lpe.get_next_longform_folder(f"{lf_dur}_{lf_topic}")
                    voice_raw_mp3 = out_folder / "meditative_voice.mp3"
                    master_mix_mp3 = out_folder / "master_soaking_audio.mp3"
                    final_16x9_mp4 = out_folder / f"{out_folder.name}.mp4"
                    final_16x9_thumb = out_folder / f"{out_folder.name}_thumb.jpg"

                    lf_loader.update(25, f"\U0001f399\ufe0f [1/3] Synthesizing Slow Soul-Prayer Voiceover ({global_v_obj['name']} at {global_rate_str})...")
                    v_res = lpe.synthesize_meditative_voiceover(
                        lf_journey, voice_raw_mp3, voice_name=global_v_obj["voice"], rate_str=global_rate_str, pitch_str="-2Hz"
                    )

                    lf_loader.update(55, f"\U0001f3b5 [2/3] Mixing {lf_dur} Master Audio (Voice + Worship Music + {lf_nature})...")
                    target_secs = lf_journey["config"]["target_seconds"]
                    lpe.mix_longform_master_audio(
                        voice_raw_mp3, master_mix_mp3, target_duration_sec=target_secs,
                        bgm_file=global_bgm_file, bgm_volume=global_bgm_vol, nature_style=lf_nature
                    )

                    lf_loader.update(80, "\U0001f3ac [3/3] Rendering Full-HD 1920x1080 (16:9) Video & 3D Gold Thumbnail...")
                    chosen_v_path = (backend.INTRO_DIR / lf_pick_vid) if (lf_pick_vid != "Auto / Newest") else (intro_vids[0] if intro_vids else backend.prepare_muted_short_main())
                    chosen_i_path = (backend.BG_DIR / lf_pick_img) if (lf_pick_img != "Auto / Newest") else (bg_imgs[0] if bg_imgs else active_wall_path)

                    ok_lf = lpe.render_longform_16x9_video(
                        master_mix_mp3, final_16x9_mp4, final_16x9_thumb, lf_journey,
                        bg_image_path=chosen_i_path, bg_video_path=chosen_v_path,
                        visual_mode=lf_vis_mode, palette_name=global_palette
                    )
                    if ok_lf:
                        lf_title, lf_desc, lf_tags = lpe.build_longform_youtube_metadata(lf_journey, v_res["chapters"])
                        backend.save_clip_metadata(final_16x9_mp4, lf_title, lf_desc, lf_tags, topic=lf_topic)
                        st.session_state["last_longform_video"] = str(final_16x9_mp4)
                        lf_loader.complete(f"\U0001f389 {lf_dur} Long-Form Prayer Video Ready: `{final_16x9_mp4.name}`!")
                        time.sleep(0.5)
                        st.rerun()

    with lf_right:
        with st.container(border=True):
            st.markdown("#### \U0001f4fa Long-Form 16:9 Studio Monitor & Publisher")
            lf_existing = [f for f in sorted(list(lpe.LONGFORM_DIR.rglob("*.mp4")), key=lambda p: p.parent.name, reverse=True) if "temp_" not in str(f)]
            lf_preview = st.session_state.get("last_longform_video")
            if not lf_preview or not Path(lf_preview).exists():
                lf_preview = str(lf_existing[0]) if lf_existing else None

            if not lf_preview:
                st.info("\U0001f54a\ufe0f Generate your first 5m, 10m, 20m, 30m, or 1-Hour Prayer Video on the left to preview & publish here!")
            else:
                lf_vp = Path(lf_preview)
                lf_tp = lf_vp.with_name(f"{lf_vp.stem}_thumb.jpg")
                lf_meta = backend.load_clip_metadata(lf_vp)
                lf_actual_dur = cached_video_dur(str(lf_vp))

                st.markdown(f"**\u23f1\ufe0f Final Video Length:** `{lpe.format_mm_ss(lf_actual_dur)}` ({lf_actual_dur/60.0:.1f} mins) &nbsp;|&nbsp; \U0001f4c1 `{lf_vp.parent.name}`")
                st.video(str(lf_vp))
                lf_tp = render_custom_thumbnail_manager(lf_vp, f"lf_{lf_vp.parent.name}") or lf_tp

                st.markdown(f"**\U0001f3c6 Title:** `{lf_meta['title']}`")
                with st.expander("\U0001f4dd View Chapter Timestamps, Description & Tags"):
                    st.text_area("Long-Form Description (with Chapters):", value=lf_meta["description"], height=160, key="lf_mon_desc")
                    st.code(", ".join(lf_meta.get("tags", [])), language="text")

                if lf_meta.get("youtube_id"):
                    st.success(f"\U0001f389 LIVE ON YOUTUBE: https://www.youtube.com/watch?v={lf_meta['youtube_id']}")
                else:
                    if st.button(f"\U0001f680 Publish 16:9 Video + Thumbnail to '{global_target_ch}'", key="lf_pub_main", width="stretch"):
                        with st.spinner(f"Uploading {lf_vp.name} to {global_target_ch}..."):
                            yt_id = backend.upload_video_to_youtube(global_target_ch, lf_vp, thumbnail_path=lf_tp)
                            if yt_id:
                                st.success(f"\U0001f389 Published! ID: {yt_id}")
                                time.sleep(1.0)
                                st.rerun()

