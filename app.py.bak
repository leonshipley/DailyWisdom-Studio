        if st.session_state.get("top_sample_mp3") and Path(st.session_state["top_sample_mp3"]).exists():
            st.audio(st.session_state["top_sample_mp3"], format="audio/mp3")
        elif global_bgm_file and Path(global_bgm_file).exists():
            st.caption("\U0001f3b5 Preview BGM:")
            st.audio(str(global_bgm_file), format="audio/mp3")

# ==============================================================================
# 3. SHORTS MAKER WORKSPACE FUNCTION (ZERO AUTO-RUN ON LOAD)
# ==============================================================================
CLASSIC_OPENING_HOOKS = [
    "Heavenly Father, I bring this prayer before You today...",
    "Before you close your eyes tonight, remember this truth...",
    "Take a deep breath and let this promise fill your heart...",
    "If your heart feels heavy right now, listen closely...",
    "Stop for 30 seconds and let God speak peace to your soul...",
    "You do not have to fight this battle alone today...",
    "God sees every tear and knows the weight you are carrying...",
    "No weapon formed against you shall prosper in this season...",
    "When everything around you feels uncertain, hold onto this...",
    "Lord Jesus, we surrender every worry into Your hands right now...",
    "Here is the divine truth God wants you to hear today...",
    "Never let fear convince you that God has forgotten you...",
    "This is your reminder that God is turning your trial into a testimony...",
    "Whatever door closed on you, God is opening a greater one...",
    "Speak this blessing over your life and your family right now...",
    "Dealing with this struggle? Here is God's unshakeable promise..."
]

def render_maker_workspace(lang_code: str):
    is_hi = (lang_code == "hi")
    pfx = "hi" if is_hi else "en"
    col_workflow, col_monitor = st.columns([1.18, 1.0], gap="large")

    with col_workflow:
        with st.container(border=True):
            st.markdown(f"#### {('\U0001f1ee\U0001f1f3 Step 1: Topic, Scripture & Opening Hook' if is_hi else '\U0001f1ec\U0001f1e7 Step 1: Topic, Scripture & Spoken Script')}")
            sel_mode = st.radio(
                "Choose Scripture By:",
                [
                    "\U0001f3b2 50 Viral Topics",
                    "\U0001f4d6 Full 66-Book Bible Browser (Book \u2794 Chapter \u2794 Verse)",
                    "\u270d\ufe0f Custom Situation",
                ],
                horizontal=True,
                key=f"{pfx}_sel_mode"
            )
            state_key = f"{pfx}_active_verse_bundle"

            if "50 Viral" in sel_mode:
                topic_labels = [f"{item['id']}. {item['topic']}" for item in TOP_50_PRAYER_TOPICS]
                chosen_t_lbl = st.selectbox("Select Topic (1-50):", topic_labels, key=f"{pfx}_topic_dd")
                chosen_t_obj = TOP_50_PRAYER_TOPICS[topic_labels.index(chosen_t_lbl)]
                topic_name = chosen_t_obj["topic"]
                ref_def = chosen_t_obj.get("ref", "Philippians 4:19")

                if st.session_state.get(f"{pfx}_last_topic") != topic_name or state_key not in st.session_state:
                    st.session_state[f"{pfx}_last_topic"] = topic_name
                    _, en_v_d, hi_v_d, _ = lookup_reference_bilingual(ref_def)
                    st.session_state[state_key] = {
                        "topic_en": topic_name, "topic_hi": topic_name,
                        "verse_citation": ref_def,
                        "en_spoken_ref": format_reference_for_speech(ref_def, is_hindi_speech=False),
                        "hi_spoken_ref": format_reference_for_speech(ref_def, is_hindi_speech=True),
                        "en_verse": en_v_d, "hi_verse": hi_v_d,
                        "meaning_en": f"Trust God's unshakeable promise regarding {topic_name}; His grace is sufficient.",
                        "meaning_hi": "Prabhu ke is vachan par bharosa rakhein; unka anugrah kaafi hai.",
                        "prayer_en": f"Lord Jesus, release Your peace and supernatural breakthrough over {topic_name}, Amen.",
                        "prayer_hi": "Prabhu Yeshu, mere jeevan mein apni shanti aur aashish dein, Amen.",
                        "hook_en": "GOD WILL PROVIDE",
                        "title_en": f"God's Promise For {topic_name[:28]} #shorts",
                        "title_hi": f"{ref_def} #shorts"
                    }

                if st.button("\U0001f52c AI Research Live Competitors & Fresh Scripture", key=f"{pfx}_reroll_btn", width="stretch"):
                    with st.spinner(f"Auditing competitors & finding optimal Scripture for '{topic_name}'..."):
                        from viral_researcher import _VIRAL_RESEARCH_CACHE
                        _VIRAL_RESEARCH_CACHE.pop(topic_name.lower(), None)
                        pkg = backend.research_viral_scripture_package(topic_name, global_target_ch)
                        st.session_state[state_key] = {
                            "topic_en": topic_name, "topic_hi": translate_any_text_to_hindi(topic_name) if is_hi else topic_name,
                            "verse_citation": pkg["verse_citation"],
                            "en_spoken_ref": pkg["verse_citation"], "hi_spoken_ref": format_reference_for_speech(pkg["verse_citation"], is_hindi_speech=True),
                            "en_verse": pkg["verse_text"], "hi_verse": translate_any_text_to_hindi(pkg["verse_text"]) if is_hi else pkg["verse_text"],
                            "meaning_en": pkg["meaning"], "meaning_hi": translate_any_text_to_hindi(pkg["meaning"]) if is_hi else pkg["meaning"],
                            "prayer_en": pkg["prayer"], "prayer_hi": translate_any_text_to_hindi(pkg["prayer"]) if is_hi else pkg["prayer"],
                            "hook_en": pkg["thumbnail_hook"], "title_en": pkg["title"], "title_hi": pkg["title"],
                            "researched_pkg": pkg
                        }
                        st.rerun()

            elif "Full 66-Book" in sel_mode:
                book_labels = [f"{i+1:02d}. {b_en.strip()} \u2014 {b_hi}" for i, (b_en, b_hi, _) in enumerate(BIBLE_66_BOOKS)]
                b_col1, b_col2, b_col3 = st.columns([1.5, 1, 1])
                with b_col1:
                    sel_b_lbl = st.selectbox("Book:", book_labels, index=18, key=f"{pfx}_bk")
                exact_book, _, max_ch = BIBLE_66_BOOKS[book_labels.index(sel_b_lbl)]
                exact_book = exact_book.strip()
                with b_col2:
                    exact_ch = st.selectbox("Chapter:", list(range(1, max_ch + 1)), index=0, key=f"{pfx}_ch")
                verses_dict = get_verses_for_chapter(exact_book, exact_ch)
                v_nums = list(verses_dict.keys()) if verses_dict else [1]
                with b_col3:
                    exact_v = st.selectbox("Verse:", v_nums, key=f"{pfx}_vs")

                ref_manual = f"{exact_book} {exact_ch}:{exact_v}"
                if st.session_state.get(f"{pfx}_last_manual_ref") != ref_manual or state_key not in st.session_state:
                    st.session_state[f"{pfx}_last_manual_ref"] = ref_manual
                    _, en_v_txt, hi_v_dev, _ = lookup_reference_bilingual(ref_manual)
                    st.session_state[state_key] = {
                        "topic_en": ref_manual, "topic_hi": format_reference_for_speech(ref_manual, is_hindi_speech=True),
                        "verse_citation": ref_manual,
                        "en_spoken_ref": format_reference_for_speech(ref_manual, is_hindi_speech=False),
                        "hi_spoken_ref": format_reference_for_speech(ref_manual, is_hindi_speech=True),
                        "en_verse": en_v_txt, "hi_verse": hi_v_dev,
                        "meaning_en": f"Trust the eternal promise of {ref_manual}; God's word never fails.",
                        "meaning_hi": f"Prabhu ke is pavitra vachan par poora bharosa rakhein.",
                        "prayer_en": f"Lord Jesus, let the truth of {ref_manual} bring breakthrough today, Amen.",
                        "prayer_hi": f"Prabhu Yeshu, mere jeevan mein aashish dein, Amen.",
                        "hook_en": f"{ref_manual.upper()} PROMISE",
                        "title_en": f"God's Promise in {ref_manual} #shorts",
                        "title_hi": f"{ref_manual} #shorts"
                    }
            else:
                custom_t_in = st.text_input("Describe Situation:", value="Breaking Financial Debt & Finding Peace", key=f"{pfx}_cust_in")
                if st.button("\U0001f52c Research Best Scripture", key=f"{pfx}_cust_btn", width="stretch"):
                    pkg = backend.research_viral_scripture_package(custom_t_in, global_target_ch)
                    st.session_state[state_key] = {
                        "topic_en": custom_t_in, "topic_hi": custom_t_in,
                        "verse_citation": pkg["verse_citation"],
                        "en_spoken_ref": pkg["verse_citation"], "hi_spoken_ref": pkg["verse_citation"],
                        "en_verse": pkg["verse_text"], "hi_verse": pkg["verse_text"],
                        "meaning_en": pkg["meaning"], "meaning_hi": pkg["meaning"],
                        "prayer_en": pkg["prayer"], "prayer_hi": pkg["prayer"],
                        "hook_en": pkg["thumbnail_hook"], "title_en": pkg["title"], "title_hi": pkg["title"],
                        "researched_pkg": pkg
                    }

            if state_key not in st.session_state:
                st.session_state[state_key] = {
                    "topic_en": "God's Peace", "topic_hi": "God's Peace",
                    "verse_citation": "Philippians 4:6-7",
                    "en_spoken_ref": "Philippians 4, verses 6 to 7", "hi_spoken_ref": "Philippians 4, verses 6 to 7",
                    "en_verse": "Do not be anxious about anything, but in everything by prayer present your requests to God, and peace will guard your heart.",
                    "hi_verse": "Kisi bhi baat ki chinta mat karo, parantu har baat mein prarthana ke dwara Parmeshwar ke sammukh nivedan karo.",
                    "meaning_en": "Surrender every fear to Christ; His peace will guard your heart.",
                    "meaning_hi": "Apni chinta Prabhu ko saunp dein; unki shanti aapke hriday ki raksha karegi.",
                    "prayer_en": "Lord Jesus, fill my spirit with Your everlasting peace today, Amen.",
                    "prayer_hi": "Prabhu Yeshu, mere mann ko apni shanti se bhar dein, Amen.",
                    "hook_en": "PEACE IN STORM",
                    "title_en": "Peace In The Storm #shorts",
                    "title_hi": "Philippians 4:6-7 #shorts"
                }

            bundle = st.session_state[state_key]
            preview_ref = bundle["verse_citation"]
            en_preview = bundle["en_verse"]
            dev_hi = bundle["hi_verse"]
            active_verse_text = dev_hi if is_hi else en_preview

            st.markdown(
                f'<div class="verse-card">'
                f'<div class="verse-hdr">\U0001f4d6 {preview_ref} ({bundle.get("en_spoken_ref", preview_ref)})</div>'
                f'<div class="verse-body">"{active_verse_text}"</div>'
                f'</div>',
                unsafe_allow_html=True
            )

            # -------------------------------------------------------------
            # 16 SELECTABLE OPENING HOOKS (INCLUDES HEAVENLY FATHER)
            # -------------------------------------------------------------
            sel_opening = st.selectbox(
                "\U0001f3af Select Opening Hook (16 Authentic Options \u2014 Zero Repetition):",
                CLASSIC_OPENING_HOOKS,
                index=0,
                key=f"{pfx}_opening_hook_sel"
            )

            # Compose the default full spoken script
            ref_spoken_str = bundle.get("en_spoken_ref", preview_ref)
            def_full_script = (
                f"{sel_opening} "
                f"{ref_spoken_str}. {active_verse_text.strip()} "
                f"{bundle.get('meaning_en', '').strip()} "
                f"{bundle.get('prayer_en', '').strip()} "
                f"Type AMEN if you receive this blessing today!"
            )

            # -------------------------------------------------------------
            # FULL SPOKEN SCRIPT PREVIEW & LIVE EDITOR (WHAT VOICE SAYS)
            # -------------------------------------------------------------
            full_spoken_edit = st.text_area(
                "\U0001f4dc Full Spoken Voiceover Script (What the Voice Will Actually Say \u2014 Fully Editable Before Generating):",
                value=st.session_state.get(f"{pfx}_manual_script", def_full_script),
                height=130,
                key=f"{pfx}_full_script_area"
            )
            st.session_state[f"{pfx}_manual_script"] = full_spoken_edit

            # Live word budget & duration indicator
            words_in_script = len(full_spoken_edit.split())
            speed_factor = 2.35 * (1.0 + (global_speed_pct / 100.0))
            est_dur = round(words_in_script / max(1.2, speed_factor) + 2.5, 1)
            st.markdown(
                f'<div class="budget-badge">\u23f1\ufe0f Script Word Budget: <b>{words_in_script} words</b> &nbsp;|&nbsp; '
                f'Est. Duration at {global_rate_str}: <b>{est_dur}s</b> &nbsp;|&nbsp; '
                f'Lyrics: <b>{global_lyrics_words} words/screen</b></div>',
                unsafe_allow_html=True
            )

        with st.container(border=True):
            st.markdown("#### \U0001f3ac Step 2: Visuals, Video Playback Mode & Stickers")
            intro_files = get_media_files(backend.INTRO_DIR, (".mp4", ".mov", ".webm", ".mkv"))
            bg_files = get_media_files(backend.BG_DIR, (".jpg", ".jpeg", ".png", ".webp"))

            v_c1, v_c2, v_c3 = st.columns(3)
            with v_c1:
                sel_vid_mode = st.selectbox("\u23f1\ufe0f Video Playback Mode:", ["Full Video", "10s Video \u2794 Wallpaper", "20s Video \u2794 Wallpaper", "Wallpaper Only"], index=0, key=f"{pfx}_v_mode")
            with v_c2:
                pick_intro_name = st.selectbox("\U0001f3ac B-Roll Video:", ["Auto / Newest"] + [f.name for f in intro_files], key=f"{pfx}_int_dd")
            with v_c3:
                pick_bg_name = st.selectbox("\U0001f5bc\ufe0f Jesus Wallpaper:", ["Auto / Newest"] + [f.name for f in bg_files], key=f"{pfx}_bg_dd")

            sticker_inventory = sticker_studio.get_sticker_inventory()
            stk_col1, stk_col2, stk_col3 = st.columns(3)
            with stk_col1:
                sel_stk_label = st.selectbox("\U0001f3f7\ufe0f Sticker / Live GIF:", list(sticker_inventory.keys()), index=1 if len(sticker_inventory) > 1 else 0, key=f"{pfx}_stk_sel")
                chosen_stk_file = sticker_inventory[sel_stk_label]
            with stk_col2:
                sel_stk_pos = st.selectbox("\U0001f4cd Sticker Position:", ["Bottom Dock (Centered)", "Bottom Right (Floating)", "Top Right Corner"], key=f"{pfx}_stk_pos")
            with stk_col3:
                sel_stk_time = st.selectbox("\u23f0 Sticker Timing:", ["Throughout Entire Video", "Outro CTA (Last 6s)", "Hook Only (First 5s)"], key=f"{pfx}_stk_time")

            with st.expander("\U0001f4e4 Upload Custom Video, Jesus Image, or GIF Sticker (Optional)", expanded=False):
                u1, u2, u3 = st.columns(3)
                with u1:
                    up_intro = st.file_uploader("Upload Video:", type=["mp4", "mov", "webm"], key=f"{pfx}_u_int")
                with u2:
                    up_bg = st.file_uploader("Upload Jesus Wallpaper:", type=["jpg", "jpeg", "png", "webp"], key=f"{pfx}_u_bg")
                with u3:
                    up_custom_stk = st.file_uploader("Upload Sticker/GIF:", type=["png", "webp", "gif"], key=f"{pfx}_u_stk")
                    if up_custom_stk is not None:
                        dest_stk = sticker_studio.STICKERS_DIR / up_custom_stk.name
                        dest_stk.write_bytes(up_custom_stk.getvalue())
                        st.success(f"Added {up_custom_stk.name}!")

            gen_btn = st.button(
                f"\u26a1 GENERATE SHORT ({preview_ref}) \u2014 Speed {global_rate_str} \u2022 {global_lyrics_words} Words/Screen",
                key=f"{pfx}_gen_btn",
                width="stretch"
            )

    with col_monitor:
        with st.container(border=True):
            st.markdown("#### \U0001f3ac Step 3: Live Output Monitor & 1-Click Publisher")
            target_preview = st.session_state.get("last_created_video")
            if not target_preview or not Path(target_preview).exists():
                target_preview = str(all_videos[0]) if all_videos else None

            if not target_preview:
                st.info("\U0001f4a1 Click Generate on the left to preview your Short and 3D Gold Thumbnails here!")
            else:
                vp = Path(target_preview)
                tp_jpg = vp.with_name(f"{vp.stem}_thumb.jpg")
                meta = backend.load_clip_metadata(vp)
                dur = cached_video_dur(str(vp))

                st.markdown(f"**\u23f1\ufe0f Final Short Duration:** `{dur:.1f}s` &nbsp;|&nbsp; \U0001f4c1 `{vp.parent.name}`")
                t_vid, t_th_vert, t_variants = st.tabs(["\U0001f3ac Video Player", "\U0001f4f1 Master 9:16 Thumbnail", "\u2728 3 Hook Variants"])
                with t_vid:
                    st.video(str(vp))
                with t_th_vert:
                    if tp_jpg.exists():
                        st.image(str(tp_jpg), width="stretch")
                with t_variants:
                    var_cols = st.columns(3)
                    for v_idx in range(1, 4):
                        v_file = vp.parent / f"thumbnail_9x16_variant_{v_idx}.png"
                        with var_cols[v_idx - 1]:
                            if v_file.exists():
                                st.image(str(v_file), caption=f"Variant #{v_idx}", width="stretch")

                # Custom Thumbnail Studio & Upload Selector
                chosen_thumb_file = render_custom_thumbnail_manager(vp, f"{pfx}_{vp.parent.name}")

                st.markdown(f"**\U0001f3c6 Title:** `{meta['title']}`")
                with st.expander("\U0001f4dd View Description & Tags"):
                    st.text_area("Description:", value=meta["description"], height=120, key=f"{pfx}_mon_desc")
                    st.code(", ".join(meta.get("tags", [])), language="text")

                if meta.get("youtube_id"):
                    st.success(f"\U0001f389 LIVE ON YOUTUBE: https://youtube.com/shorts/{meta['youtube_id']}")
                else:
                    if st.button(f"\U0001f680 1-Click Publish Video + Thumbnail to '{global_target_ch}'", key=f"{pfx}_mon_up_main", width="stretch"):
                        with st.spinner(f"Publishing to {global_target_ch}..."):
                            yt_id = backend.upload_video_to_youtube(global_target_ch, vp, thumbnail_path=chosen_thumb_file)
                            if yt_id:
                                st.success(f"Live! https://youtube.com/shorts/{yt_id}")
                                time.sleep(1.0)
                                st.rerun()

    if gen_btn:
        with col_workflow:
            loader = LiveTaskLoader("Generating High-Retention Short")
            active_maker_voice = dict(
                global_v_obj,
                rate=global_rate_str,
                accent=global_acc,
                script_mode=SCRIPT_MODES[1] if is_hi else SCRIPT_MODES[0],
            )
            save_active_voice(active_maker_voice)

            script = backend.BibleShortScript(
                topic=bundle["topic_hi"] if is_hi else bundle["topic_en"],
                title=bundle["title_hi"] if is_hi else bundle["title_en"],
                verse_citation=preview_ref,
                verse_text=dev_hi if is_hi else en_preview,
                meaning=bundle.get("meaning_en", ""),
                prayer=bundle.get("prayer_en", ""),
                thumbnail_hook=bundle.get("hook_en", "GOD WILL PROVIDE"),
                hashtags=["#HindiBible", "#YeshuMasih", "#Prarthana", "#Shorts"] if is_hi else ["#BibleVerse", "#DailyPrayer", "#Faith", "#Shorts"],
            )

            loader.update(30, f"\U0001f399\ufe0f [1/3] Synthesizing Exact Voiceover ({global_v_obj['name']} at {global_rate_str})...")
            # Read EXACT text from the full spoken script preview area!
            temp_voice = backend.BASE_DIR / "temp_voice.mp3"
            backend.generate_voiceover(full_spoken_edit.strip(), temp_voice)

            loader.update(65, f"\u26a1 [2/3] Rendering 1080p Video ({global_lyrics_words} Words/Screen Lyrics) + 3D Gold Thumbnail...")
            tag_prefix = "Hindi_Bible" if is_hi else "English_Bible"
            clean_name = backend.clean_filename(f"{tag_prefix}_{bundle['topic_en']}_{preview_ref}")
            seq_dir = backend.get_next_sequence_folder(clean_name)
            out_video = seq_dir / f"{clean_name}.mp4"
            out_thumb = seq_dir / f"{clean_name}_thumb.jpg"

            c_intro_path = None
            if up_intro is not None:
                c_intro_path = backend.INTRO_DIR / f"{backend.clean_filename(Path(up_intro.name).stem)}{Path(up_intro.name).suffix.lower()}"
                c_intro_path.write_bytes(up_intro.getvalue())
                c_intro_path = backend.mute_any_video(c_intro_path)
            elif pick_intro_name != "Auto / Newest":
                c_intro_path = backend.mute_any_video(backend.INTRO_DIR / pick_intro_name)
            elif intro_files:
                c_intro_path = backend.mute_any_video(intro_files[0])

            c_bg_path = None
            if up_bg is not None:
                c_bg_path = backend.BG_DIR / f"{backend.clean_filename(Path(up_bg.name).stem)}{Path(up_bg.name).suffix.lower()}"
                c_bg_path.write_bytes(up_bg.getvalue())
            elif pick_bg_name != "Auto / Newest":
                c_bg_path = backend.BG_DIR / pick_bg_name
            elif bg_files:
                c_bg_path = bg_files[0]
            else:
                c_bg_path = active_wall_path

            ok = backend.render_faceless_bible_video(
                script, temp_voice, out_video, out_thumb,
                custom_intro=c_intro_path, custom_bg=c_bg_path,
                custom_thumb=c_bg_path, raw_thumb_only=False,
                palette_name=global_palette, custom_bgm=global_bgm_file, bgm_volume=global_bgm_vol,
                video_mode=sel_vid_mode, sticker_path=chosen_stk_file,
                sticker_position=sel_stk_pos, sticker_timing=sel_stk_time,
                lyrics_words_per_card=global_lyrics_words
            )
            if temp_voice.exists():
                temp_voice.unlink(missing_ok=True)

            if ok:
                loader.update(90, "\U0001f525 [3/3] Finalizing Viral Description & 380-Char Search Tags...")
                if "researched_pkg" in bundle:
                    pkg = bundle["researched_pkg"]
                    opt_title = pkg.get("title", script.title)
                    opt_desc = pkg.get("description", "")
                    opt_tags = pkg.get("tags", script.hashtags)
                else:
                    raw_desc, dynamic_hts = backend.build_viral_devotional_description(
                        bundle["topic_en"], preview_ref, en_preview, bundle.get("meaning_en", ""), bundle.get("prayer_en", "")
                    )
                    opt_title, opt_desc, opt_tags = backend.optimize_with_virality_engine(
                        bundle["topic_en"], script.title, raw_desc, dynamic_hts, global_target_ch,
                        hook=bundle["hook_en"], video_dir=seq_dir
                    )
                backend.save_clip_metadata(out_video, opt_title, opt_desc, opt_tags, topic=bundle["topic_en"])
                loader.complete(f"\U0001f389 Created `{seq_dir.name}`!")
                st.session_state["last_created_video"] = str(out_video)
                time.sleep(0.4)
                st.rerun()

# ==============================================================================
# 4. MAIN 7 STUDIO TABS (DECLARED AT TOP MODULE LEVEL)
# ==============================================================================
tab_en, tab_hi, tab_long, tab_story, tab_lib, tab_pod, tab_stats = st.tabs([
    "\U0001f1ec\U0001f1e7 1. English Shorts",
    "\U0001f1ee\U0001f1f3 2. Hindi Shorts",
    "\U0001f54a\ufe0f 3. Long-Form Prayers (5m-1Hr)",
    "\U0001f3ac 4. 3-Min Flow AI Story Maker",
    "\U0001f4c2 5. Video Library",
    "\U0001f399\ufe0f 6. Podcast Clipper",
    "\U0001f4ca 7. Channel Analytics",
])

with tab_en:
    with st.container(border=True):
        st.markdown("#### \U0001f54a\ufe0f Grace of the Lord (@GraceAndDailyPrayer) \u2014 6-Archetype 3-Scene Original Shorts Studio")
        st.caption("Monetization-Safe \u2022 Zero Banned Openings \u2022 6 Rotating Archetypes \u2022 3 Distinct AI Scene Prompts (zoom_in \u2794 pan_up \u2794 zoom_out) \u2022 Direct YouTube Publisher")

        gr_left, gr_right = st.columns([1.22, 1.0], gap="large")

        with gr_left:
            gr_c1, gr_c2 = st.columns(2)
            with gr_c1:
                gr_arch = st.selectbox("\U0001f3ad Narrative Archetype (Anti-Repetition):", list(gle.ARCHETYPES.keys()), index=0, key="gr_arch_sel")
            with gr_c2:
                gr_t_labels = [f"{item['id']}. {item['topic']}" for item in TOP_50_PRAYER_TOPICS]
                gr_t_pick = st.selectbox("\U0001f4d6 Prayer / Life Topic:", ["Custom Topic (Type Below)"] + gr_t_labels, index=1, key="gr_t_pick")

            if gr_t_pick == "Custom Topic (Type Below)":
                gr_topic = st.text_input("Custom Topic:", value="Staring at the ceiling at 2 AM worried about tomorrow", key="gr_cust_t")
            else:
                gr_topic = TOP_50_PRAYER_TOPICS[gr_t_labels.index(gr_t_pick)]["topic"]

            with st.expander("\U0001f517 Configure Your 3 Amazon Affiliate Links (Auto-Inserted into Clean Description)", expanded=False):
                cur_affs = gle.load_affiliate_links()
                af1, af2, af3 = st.columns(3)
                with af1:
                    h1 = st.text_input("Heading 1:", value=cur_affs[0]["heading"], key="af_h1")
                    u1 = st.text_input("URL 1:", value=cur_affs[0]["url"], key="af_u1")
                with af2:
                    h2 = st.text_input("Heading 2:", value=cur_affs[1]["heading"], key="af_h2")
                    u2 = st.text_input("URL 2:", value=cur_affs[1]["url"], key="af_u2")
                with af3:
                    h3 = st.text_input("Heading 3:", value=cur_affs[2]["heading"], key="af_h3")
                    u3 = st.text_input("URL 3:", value=cur_affs[2]["url"], key="af_u3")
                if st.button("\U0001f4be Save 3 Amazon Affiliate Links", key="save_aff_btn"):
                    gle.save_affiliate_links([{"heading": h1, "url": u1}, {"heading": h2, "url": u2}, {"heading": h3, "url": u3}])
                    st.success("\u2705 Saved affiliate links!")

            if st.button("\U0001f3ac 1. Write 6-Archetype 3-Scene Script & Prompts", key="gr_write_btn", width="stretch"):
                with st.spinner("Writing authentic 3-Scene Grace of the Lord script..."):
                    st.session_state["active_grace_pkg"] = gle.generate_grace_3scene_script(gr_topic, gr_arch)

            if "active_grace_pkg" not in st.session_state:
                st.info("\U0001f449 Click **1. Write 6-Archetype 3-Scene Script & Prompts** above to generate your non-repetitive 3-scene storyboard.")
            else:
                gpkg = st.session_state["active_grace_pkg"]
                g_segs = gpkg.get("spoken_script_segments", [])
                rec_tone = gpkg.get("recommended_voice_tone", "deep_pastoral_male")
                tone_info = gle.VOICE_TONE_MAP.get(rec_tone, gle.VOICE_TONE_MAP["deep_pastoral_male"])

                st.markdown(
                    f'<div class="budget-badge">\U0001f3ad Archetype: <b>{gpkg.get("archetype_used")}</b> &nbsp;|&nbsp; '
                    f'\U0001f399\ufe0f Recommended Tone: <b>{tone_info["label"]}</b></div>',
                    unsafe_allow_html=True
                )
                gpkg["youtube_title"] = st.text_input("\U0001f3c6 YouTube Short Title:", value=gpkg.get("youtube_title", ""), key="gr_title_ed")

                sc_cols = st.columns(3)
                for idx_g, seg_g in enumerate(g_segs[:3]):
                    with sc_cols[idx_g]:
                        st.markdown(f"**Scene {seg_g['scene_number']}** (`{seg_g.get('camera_motion', 'zoom_in_slow')}`)")
                        seg_g["spoken_text"] = st.text_area(f"Spoken (Scene {idx_g+1}):", value=seg_g.get("spoken_text", ""), height=92, key=f"gr_sp_{idx_g}")
                        seg_g["image_prompt"] = st.text_area(f"9:16 Prompt (Scene {idx_g+1}):", value=seg_g.get("image_prompt", ""), height=78, key=f"gr_im_{idx_g}")

                with st.expander("\U0001f4dd Edit Clean YouTube Description & Pinned Comment", expanded=False):
                    gpkg["clean_youtube_description"] = st.text_area("Clean Description (No [HASHTAGS] brackets):", value=gpkg.get("clean_youtube_description", ""), height=150, key="gr_desc_ed")
                    gpkg["pinned_comment_text"] = st.text_input("Pinned Comment Text:", value=gpkg.get("pinned_comment_text", ""), key="gr_pin_ed")

                gr_stk_inv = sticker_studio.get_sticker_inventory()
                gs1, gs2 = st.columns(2)
                with gs1:
                    use_rec_tone = st.checkbox(f"Use Recommended Voice ({tone_info['label']})", value=False, key="gr_use_rec_v")
                with gs2:
                    gr_stk_lbl = st.selectbox("\U0001f3f7\ufe0f Sticker Overlay:", list(gr_stk_inv.keys()), index=1 if len(gr_stk_inv) > 1 else 0, key="gr_stk_sel")
                    gr_stk_path = gr_stk_inv[gr_stk_lbl]

                if st.button(f"\u26a1 2. GENERATE 3-SCENE 'GRACE OF THE LORD' SHORT (Speed {global_rate_str} \u2022 {global_lyrics_words} Words/Screen)", key="gr_render_3sc_btn", width="stretch"):
                    gr_loader = LiveTaskLoader("Producing 3-Scene Grace of the Lord Short")
                    chosen_v_id = tone_info["voice"] if use_rec_tone else global_v_obj["voice"]
                    ok_gr, out_gr_v, out_gr_th = gle.render_grace_3scene_short(
                        gpkg,
                        voice_id=chosen_v_id,
                        voice_rate=global_rate_str,
                        lyrics_words_per_card=global_lyrics_words,
                        bgm_file=global_bgm_file,
                        bgm_vol=global_bgm_vol,
                        palette_name=global_palette,
                        sticker_path=gr_stk_path,
                        progress_cb=lambda p, m: gr_loader.update(p, m)
                    )
                    if ok_gr:
                        st.session_state["last_created_video"] = str(out_gr_v)
                        st.session_state["last_grace_video"] = str(out_gr_v)
                        gr_loader.complete(f"\U0001f389 Rendered 3-Scene Short: `{out_gr_v.name}`!")
                        time.sleep(0.4)
                        st.rerun()

        # RIGHT COLUMN: DEDICATED PREVIEW, THUMBNAIL VARIANT PICKER & 1-CLICK UPLOAD TO GRACE OF THE LORD
        with gr_right:
            st.markdown("##### \U0001f4fa Grace of the Lord (@GraceAndDailyPrayer) \u2014 Monitor & Direct Publisher")
            gr_vid_str = st.session_state.get("last_grace_video") or st.session_state.get("last_created_video")
            if not gr_vid_str or not Path(gr_vid_str).exists():
                gr_vid_str = str(all_videos[0]) if all_videos else None

            if not gr_vid_str:
                st.info("\U0001f54a\ufe0f Your generated 3-Scene Short, 3D Gold Thumbnails, and 1-Click Upload button for **Grace of the Lord (@GraceAndDailyPrayer)** will appear right here!")
            else:
                gvp = Path(gr_vid_str)
                gtp = gvp.with_name(f"{gvp.stem}_thumb.jpg")
                gmeta = backend.load_clip_metadata(gvp)
                gdur = cached_video_dur(str(gvp))
                gpin_f = gvp.parent / "pinned_comment.txt"
                gpin_txt = gpin_f.read_text(encoding="utf-8").strip() if gpin_f.exists() else "How can we pray for you today? Comment AMEN below! \U0001f64f"

                st.markdown(f"**\u23f1\ufe0f Duration:** `{gdur:.1f}s` &nbsp;|&nbsp; \U0001f4c1 `{gvp.parent.name}`")
                gtab_v, gtab_t, gtab_3 = st.tabs(["\U0001f3ac Short Video", "\U0001f4f1 Master 9:16 Thumbnail", "\u2728 3 Hook Variants"])
                with gtab_v:
                    st.video(str(gvp))
                with gtab_t:
                    if gtp.exists():
                        st.image(str(gtp), width="stretch")
                with gtab_3:
                    gv_cols = st.columns(3)
                    for v_i in range(1, 4):
                        vf_p = gvp.parent / f"thumbnail_9x16_variant_{v_i}.png"
                        with gv_cols[v_i - 1]:
                            if vf_p.exists():
                                st.image(str(vf_p), caption=f"Variant #{v_i}", width="stretch")

                g_sel_th_file = render_custom_thumbnail_manager(gvp, f'gr_{gvp.parent.name}')

                ed_title = st.text_input("\U0001f4cc Publish Title:", value=gmeta.get("title", ""), key=f"gr_pub_t_{gvp.parent.name}")
                ed_pin = st.text_input("\U0001f4ac Auto-Post Pinned Comment:", value=gpin_txt, key=f"gr_pub_pin_{gvp.parent.name}")
                with st.expander("\U0001f4dd View / Edit Publish Description & Tags", expanded=False):
                    ed_desc = st.text_area("Clean Description:", value=gmeta.get("description", ""), height=130, key=f"gr_pub_d_{gvp.parent.name}")
                    st.code(", ".join(gmeta.get("tags", [])), language="text")

                pub_ch = st.selectbox("\U0001f4fa Upload Channel:", channel_names, index=0, key="gr_pub_ch_sel")

                if gmeta.get("youtube_id"):
                    st.success(f"\U0001f389 LIVE ON YOUTUBE: https://youtube.com/shorts/{gmeta['youtube_id']}")
                else:
                    if st.button(f"\U0001f680 PUBLISH SHORT + THUMBNAIL + COMMENT TO '{pub_ch}'", key="gr_direct_pub_btn", width="stretch"):
                        pub_loader = LiveTaskLoader(f"Publishing to {pub_ch}")
                        backend.save_clip_metadata(gvp, ed_title, ed_desc, gmeta.get("tags", []), topic=gmeta.get("topic", ""))
                        gpin_f.write_text(ed_pin, encoding="utf-8")
                        pub_loader.update(40, "Uploading MP4 Short & Custom 9:16 Thumbnail to YouTube...")
                        yt_id = backend.upload_video_to_youtube(pub_ch, gvp, thumbnail_path=g_sel_th_file)
                        if yt_id:
                            pub_loader.update(85, "Posting Pinned Prayer Comment via YouTube API...")
                            gle.post_pinned_comment_if_possible(pub_ch, yt_id, gvp)
                            pub_loader.complete(f"\U0001f389 LIVE ON YOUTUBE: https://youtube.com/shorts/{yt_id}")
                            time.sleep(1.0)
                            st.rerun()
    st.divider()
    with st.expander("\U0001f6e0\ufe0f Classic Single-Scene Quick Shorts Maker (Optional)", expanded=False):
        render_maker_workspace("en")

with tab_hi:
    render_maker_workspace("hi")

